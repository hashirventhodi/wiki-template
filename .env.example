# Canonical public URL of the deployed wiki (no trailing slash), e.g.
#   NEXT_PUBLIC_SITE_URL=https://wiki.yourcompany.com
#
# Used for page metadata and the absolute links in /llms.txt and /llms-full.txt.
# - Local dev: leave unset — it falls back to http://localhost:3000.
# - Vercel: optional — auto-detected from VERCEL_PROJECT_PRODUCTION_URL if unset.
# - Other hosts: set this in your deploy environment so links resolve correctly.
NEXT_PUBLIC_SITE_URL=
